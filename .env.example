# Copiar a .env y completar. El .env no se versiona (criterio de aceptacion 9).

POSTGRES_DB=tablero
POSTGRES_USER=tablero
POSTGRES_PASSWORD=cambiar-esta-clave

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-esta-clave
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Lo consume el navegador: tiene que ser la URL del backend vista desde la maquina del usuario.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
